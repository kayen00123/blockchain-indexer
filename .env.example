# Core application and database
HTTP_REQUEST_TIMEOUT_MS=10000
POSTGRES_POOL_MAX=20
HEALTH_LOG_INTERVAL_MS=60000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PUMPSWAP_PROGRAM_ID=your-pumpswap-program-id
ENABLE_PRICE_FETCHING=false

# Solana websocket providers
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_BLOCK_WS_URL=wss://your-solana-blocksubscribe-endpoint
SOLANA_PRICE_WS_URL=wss://your-solana-accountsubscribe-endpoint
# SOLANA_BLOCK_WS_URL_1=wss://your-solana-block-provider-1
# SOLANA_BLOCK_WS_URL_2=wss://your-solana-block-provider-2
# SOLANA_BLOCK_WS_URL_3=wss://your-solana-block-provider-3
# SOLANA_BLOCK_WS_URL_4=wss://your-solana-block-provider-4
# SOLANA_BLOCK_WS_URL_5=wss://your-solana-block-provider-5
# SOLANA_BLOCK_WS_URL_6=wss://your-solana-block-provider-6
# SOLANA_PRICE_WS_URL_1=wss://your-solana-price-provider-1
# SOLANA_PRICE_WS_URL_2=wss://your-solana-price-provider-2
# SOLANA_PRICE_WS_URL_3=wss://your-solana-price-provider-3
# SOLANA_PRICE_WS_URL_4=wss://your-solana-price-provider-4
# SOLANA_PRICE_WS_URL_5=wss://your-solana-price-provider-5
# SOLANA_PRICE_WS_URL_6=wss://your-solana-price-provider-6
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SHYFT_WS_URL=wss://rpc.shyft.to?api_key=your-shyft-api-key
RAYDIUM_BLOCK_WS_URL=wss://your-raydium-blocksubscribe-endpoint
RAYDIUM_PRICE_WS_URL=wss://your-raydium-price-websocket-endpoint
# RAYDIUM_BLOCK_WS_URL_1=wss://your-raydium-block-provider-1
# RAYDIUM_BLOCK_WS_URL_2=wss://your-raydium-block-provider-2
# RAYDIUM_BLOCK_WS_URL_3=wss://your-raydium-block-provider-3
# RAYDIUM_BLOCK_WS_URL_4=wss://your-raydium-block-provider-4
# RAYDIUM_BLOCK_WS_URL_5=wss://your-raydium-block-provider-5
# RAYDIUM_BLOCK_WS_URL_6=wss://your-raydium-block-provider-6
# RAYDIUM_PRICE_WS_URL_1=wss://your-raydium-price-provider-1
# RAYDIUM_PRICE_WS_URL_2=wss://your-raydium-price-provider-2
# RAYDIUM_PRICE_WS_URL_3=wss://your-raydium-price-provider-3
# RAYDIUM_PRICE_WS_URL_4=wss://your-raydium-price-provider-4
# RAYDIUM_PRICE_WS_URL_5=wss://your-raydium-price-provider-5
# RAYDIUM_PRICE_WS_URL_6=wss://your-raydium-price-provider-6
METEORA_DLMM_BLOCK_WS_URL=wss://your-meteora-dlmm-blocksubscribe-endpoint
METEORA_DLMM_PRICE_WS_URL=wss://your-meteora-dlmm-accountsubscribe-endpoint
METEORA_DAMM_V2_BLOCK_WS_URL=wss://your-meteora-damm-v2-blocksubscribe-endpoint
METEORA_DAMM_V2_PRICE_WS_URL=wss://your-meteora-damm-v2-accountsubscribe-endpoint
ORCA_WHIRLPOOL_BLOCK_WS_URL=wss://your-orca-whirlpool-blocksubscribe-endpoint
ORCA_WHIRLPOOL_PRICE_WS_URL=wss://your-orca-whirlpool-accountsubscribe-endpoint
# Add _1 through _6 slots for each METEORA_* and ORCA_WHIRLPOOL_* websocket variable above.

# BSC websocket providers
PANCAKESWAP_V2_WS_URL=wss://your-bsc-websocket-endpoint
PANCAKESWAP_V3_WS_URL=wss://your-bsc-websocket-endpoint
PANCAKESWAP_V3_WS_URL_1=wss://your-bsc-websocket-endpoint-1
PANCAKESWAP_V3_WS_URL_2=wss://your-bsc-websocket-endpoint-2
PANCAKESWAP_V2_SWAP_THRESHOLD=100
PANCAKESWAP_V2_MIN_UNIQUE_WALLETS=20
PANCAKESWAP_V2_PRICE_EVENT_FILE=pancakeswap-v2-price-events.jsonl
BNB_PRICE_URL=https://api.geckoterminal.com/api/v2/simple/networks/bsc/token_price/0xbb4cdb9cbd36b01bd1cbaebf2de08d9173bc095c

# Base websocket providers
UNISWAP_V3_BASE_WS_URL=wss://your-base-websocket-endpoint
UNISWAP_V2_BASE_WS_URL=wss://your-base-websocket-endpoint

# Robinhood websocket providers (up to six endpoints per service)
ROBINHOOD_V4_WS_URL=wss://your-robinhood-websocket-endpoint
ROBINHOOD_V3_WS_URL=wss://your-robinhood-websocket-endpoint
ROBINHOOD_V3_WS_URL_1=wss://your-robinhood-websocket-endpoint-1
ROBINHOOD_V3_WS_URL_2=wss://your-robinhood-websocket-endpoint-2
ROBINHOOD_USDG=0x0000000000000000000000000000000000000000

# Uniswap V3/V4 BSC websocket providers
UNISWAP_V3_BSC_WS_URL=wss://your-bsc-websocket-endpoint
UNISWAP_V4_BSC_WS_URL=wss://your-bsc-websocket-endpoint

# Optional rotation list format: PREFIX_WS_URLS=url1,url2,url3

# Unified price output for the full indexer run
REFERENCE_PRICE_TTL_MS=180000
REFERENCE_PRICE_TIMEOUT_MS=10000
UNIFIED_PRICE_EVENT_FILE=unified-price-events.jsonl
UNIFIED_PRICE_EVENT_POLL_MS=1000
METEORA_DAMM_V2_PRICE_EVENT_FILE=meteora-damm-v2-price-events.jsonl
METEORA_DAMM_V2_ACCOUNT_SUBSCRIBE_DELAY_MS=500
ORCA_WHIRLPOOL_PRICE_EVENT_FILE=orca-whirlpool-price-events.jsonl
ORCA_WHIRLPOOL_ACCOUNT_SUBSCRIBE_DELAY_MS=500
METEORA_DLMM_PRICE_EVENT_FILE=meteora-dlmm-price-events.jsonl
METEORA_DLMM_ACCOUNT_SUBSCRIBE_DELAY_MS=500
SOL_PRICE_URL=https://api.geckoterminal.com/api/v2/simple/networks/solana/token_price/So11111111111111111111111111111111111111112
PRICE_EVENT_FILE=price-events.jsonl
METAPLEX_RPC_URL=https://your-metaplex-das-endpoint
# Token logo worker
TOKEN_LOGO_WORKER_INTERVAL_MS=900000
TOKEN_LOGO_WORKER_REQUEST_DELAY_MS=250
TOKEN_LOGO_WORKER_BATCH_SIZE=50
TOKEN_LOGO_WORKER_REQUEST_TIMEOUT_MS=10000
TOKEN_LOGO_WORKER_CONCURRENCY=5
TOKEN_LOGO_DEXSCREENER_BSC_NETWORK=bsc
TOKEN_LOGO_DEXSCREENER_BASE_NETWORK=base
TOKEN_LOGO_DEXSCREENER_ROBINHOOD_NETWORK=robinhood
PROMOTION_SWAP_THRESHOLD=1000
PROMOTION_WINDOW_MS=900000
PROMOTION_MIN_UNIQUE_WALLETS=50
PROMOTION_STALE_MS=60000
PROMOTION_FAILURE_FILE=promotion-failures.jsonl
